{
  "name": "dni-js",
  "version": "0.2.1",
  "description": "Compute and validate a Spanish DNI/NIE number",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "src/index.js",
    "src/index.d.ts",
    "src/letterMap.js"
  ],
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "types:check": "tsc --noEmit",
    "test:watch": "jest --watch",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/albertfdp/dni-js.git"
  },
  "keywords": [
    "dni",
    "nie",
    "spain",
    "spanish"
  ],
  "author": "Albert Fernández <albert@nandez.cat>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/albertfdp/dni-js/issues"
  },
  "homepage": "https://github.com/albertfdp/dni-js#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-jest": "^29.16.0",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@typescript-eslint/eslint-plugin"
      ],
      "allowedVersions": {
        "typescript": "7"
      }
    }
  }
}
